include LICENSE README.md CHANGELOG.md CITATION.cff CONTRIBUTING.md Dockerfile run_clipp_main.py
recursive-include src *.py *.R *.cpp *.h *.inc
recursive-include tests *.py *.json *.txt *.tsv
recursive-include sample *.txt *.md *.json
